            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "schema-values": {
          "description": "A schema’s enum, const, default and examples fit its type, at every depth. Default: error.",
