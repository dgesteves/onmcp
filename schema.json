                  },
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "tool-annotations": {
          "description": "A tool’s annotations agree with each other, and none says a tool named for deleting is safe. Default: error.",
