            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "hidden-characters": {
          "description": "No invisible characters in any text a model reads: names, descriptions, schemas. Default: error.",
          "anyOf": [
            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "injection-phrases": {
          "description": "No text that tells the model to drop its instructions, hide things from the user, or poses as a system message. Default: error.",
          "anyOf": [
            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
