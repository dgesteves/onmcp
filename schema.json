            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "prompt-description": {
          "description": "Every prompt, and each of its arguments, has a description. Default: warning.",
          "anyOf": [
            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "resource-description": {
          "description": "Every resource and resource template has a description. Default: warning.",
          "anyOf": [
            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "uri-template": {
          "description": "A resource template’s variables are in {braces}, and each brace closes. Default: error.",
          "anyOf": [
            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
