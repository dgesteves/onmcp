{
  "$id": "https://unpkg.com/onmcp/schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "onmcp config",
  "description": "onmcp.config.json: which rules onmcp runs, at what severity, with what options.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rules": {
      "description": "Each rule’s setting: \"off\", \"warning\" or \"error\", or [severity, options]. A rule the config leaves out runs at its default severity.",
      "type": "object",
      "properties": {
        "tool-description": {
          "description": "Every tool has a description. Default: error.",
          "anyOf": [
            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "tool-name": {
          "description": "Tool names use only the characters MCP allows, and at most 128 of them. Default: error.",
          "anyOf": [
            {
              "enum": [
                "off",
                "warning",
                "error"
              ]
            },
            {
              "type": "array",
              "items": [
                {
                  "$ref": "#/definitions/severity"
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
